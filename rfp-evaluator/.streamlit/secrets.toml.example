# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit real keys.

# Option A - Anthropic Claude
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5-5"

# Option B - any OpenAI-compatible endpoint (OpenAI, Groq, Together, Ollama, Gemini OpenAI endpoint ...)
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = ""      # blank for OpenAI
